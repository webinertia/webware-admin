{
    "name": "webware/webware-admin",
    "description": "Mezzio admin dashboard framework: widget system, ACL-filtered rendering, and navigation for the webware-* package family.",
    "license": "BSD-3-Clause",
    "keywords": [
        "webware",
        "admin",
        "mezzio",
        "dashboard"
    ],
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "~8.4.1 || ~8.5.0",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-permissions-acl": "^2.16",
        "laminas/laminas-view": "^3.0",
        "mezzio/mezzio": "^3.26",
        "mezzio/mezzio-authentication": "^1.13",
        "mezzio/mezzio-helpers": "^5.0",
        "mezzio/mezzio-router": "^3.15 || ^4.0",
        "mezzio/mezzio-template": "^2.8 || ^3.0",
        "php-standard-library/type": "^6.2",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "webware/webware-acl": "0.1.x-dev",
        "webware/webware-core": "0.1.x-dev"
    },
    "require-dev": {
        "infection/infection": "^0.34.1",
        "phpbench/phpbench": "^1.7",
        "phpunit/phpunit": "^13.3",
        "roave/backward-compatibility-check": "^8.21.0",
        "roave/security-advisories": "dev-master",
        "webware/coding-standard": "^0.1.0",
        "webware/webware-tools": "^0.1.x-dev"
    },
    "autoload": {
        "psr-4": {
            "Webware\\Admin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebwareTest\\Admin\\": "test/unit/",
            "WebwareTestIntegration\\Admin\\": "test/integration/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/webinertia/webware-core"
        },
        {
            "type": "vcs",
            "url": "https://github.com/webinertia/webware-acl"
        },
        {
            "type": "vcs",
            "url": "https://github.com/webinertia/webware-resultset"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "github-protocols": ["https"],
        "platform": {
            "php": "8.4.99"
        },
        "allow-plugins": {
            "infection/extension-installer": true,
            "laminas/laminas-component-installer": true
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml --coverage-html coverage/html --coverage-text",
        "test-integration": "phpunit --no-coverage --colors=always --testsuite \"integration test\"",
        "mutation-test": "infection"
    }
}
